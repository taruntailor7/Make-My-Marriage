# MongoDB Atlas — M0 free cluster (AWS Mumbai region)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/make-my-marriage

# NextAuth.js v5
NEXTAUTH_SECRET=<run: openssl rand -base64 32>
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary — from https://console.cloudinary.com/settings
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend — from https://resend.com/api-keys
RESEND_API_KEY=

# Vercel Cron Job secret — any random string
CRON_SECRET=<run: openssl rand -base64 32>
